# Stripe secret key. Hosted Checkout only — no publishable key needed.
STRIPE_SECRET_KEY=

# Absolute URL of this deployment (e.g. https://your-app.vercel.app).
# Used to build the Stripe success_url. Falls back to the request host if unset.
APP_URL=

# cnMaestro EasyPass Third-Party Integration Base URL, exactly as provided
# by cnMaestro (may already include a path prefix — do not trim it).
CNMAESTRO_BASE_URL=

# cnMaestro EasyPass Third-Party Integration secret key (sent as a Bearer token).
CNMAESTRO_SECRET_KEY=

# Guest account credentials required by the cnMaestro external portal login body.
CNMAESTRO_GA_USER=
CNMAESTRO_GA_PASS=
